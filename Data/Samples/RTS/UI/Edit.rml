<rml>

  <head>
    <link type="text/template" href="rmlui-default/template.rml" />
    <link type="text/css" href="game-widget.rcss" />
  </head>

  <body class="game-widget">
    <div class="title">
      Edit Level
    </div>
    <div class="content" data-model="EditLevelModel">
      <div class="property">
        <div class="label">Team</div>
        <select id="team" data-value="Team">
          <option value="0">Red</option>
          <option value="1">Green</option>
          <option value="2">Blue</option>
          <option value="3">Yellow</option>
        </select>
      </div>
      <div class="property">
        <div class="label">Build</div>
        <select id="shipType" data-value="ShipType">
          <option value="0">Federation Ship 1</option>
          <option value="1">Federation Ship 2</option>
          <option value="2">Federation Ship 3</option>
          <option value="3">Klingon Ship 1</option>
          <option value="4">Klingon Ship 2</option>
          <option value="5">Klingon Ship 3</option>

          <option value="5">Klingon Ship 4</option>
          <option value="5">Klingon Ship 5</option>
          <option value="5">Klingon Ship 6</option>
          <option value="5">Klingon Ship 7</option>
          <option value="2">Federation Ship 8</option>
          <option value="2">Federation Ship 9</option>
          <option value="2">Federation Ship 10</option>
          <option value="2">Federation Ship 11</option>
          <option value="2">Federation Ship 12</option>
          <option value="2">Federation Ship 13</option>

        </select>
      </div>
      <div>Select: {{SelectKey}}</div>
      <div>Create: {{CreateKey}}</div>
      <div>Remove: {{RemoveKey}}</div>
    </div>
  </body>
</rml>